# Archivos de sistema y entorno local
.DS_Store
Thumbs.db

# Secretos y variables de entorno (OBLIGATORIO)
.env
.env.*
!.env.example

# Datos persistentes de Docker locales
postgres_data/
n8n_data/
~/.openhands-state/
.openhands-state/

# Credenciales OAuth locales del MCP (nunca commitear)
config/mcp-auth/.gauth.json
config/mcp-auth/.accounts.json

# Sandbox de OpenHands (trackear solo el ancla del directorio)
workspace/*
!workspace/.gitkeep

# Inbox humano de inspect (commitear README; dumps los revisás vos)
operator-inbox/*
!operator-inbox/README.md

# Dependencias y caches
node_modules/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.log
