            }
          ]
        }
      },
      "id": "if-approve-ops-09",
      "name": "¿Aprobar Ops?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1040, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://murray-agent:8080/ops/execute",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ approval_id: String($json.callback_query.data).replace(/^APPROVE_OPS:/, '') }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "http-ops-execute-10",
      "name": "Ejecutar Ops",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
