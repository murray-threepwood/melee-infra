      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://murray-agent:8080/ops/reject",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ approval_id: String($json.callback_query.data).replace(/^REJECT_OPS:/, '') }) }}",
        "options": { "timeout": 20000 }
      },
      "id": "http-ops-reject-11",
      "name": "Rechazar Ops",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1260, 500],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.callback_query.data }}",
              "operation": "startsWith",
              "value2": "APPROVE_TASK"
            }
          ]
        }
      },
      "id": "if-approve-07",
      "name": "¿Aprobar OpenHands?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1040, 240]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst data = String($json.callback_query.data || '');\nconst id = data.split(':')[1] || '';\nconst missions = staticData.missions || {};\nconst text = missions[id] || ('Misión HITL ' + id);\nreturn [{ json: { mission_text: text, mission_id: id, callback_query: $json.callback_query } }];\n"
      },
      "id": "code-load-mission-12",
      "name": "Recuperar Texto Misión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1260, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://openhands:3000/api/v1/app-conversations",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: 'HITL ' + $json.mission_id, initial_message: { role: 'user', content: [{ type: 'text', text: String($json.mission_text) }] } }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "http-dispatch-openhands-05",
      "name": "Delegar a OpenHands",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1480, 180],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.callback_query.message.chat.id }}",
        "text": "={{ $json.reply || ('✅ Orden procesada: ' + $('Telegram Trigger').item.json.callback_query.data + '.') }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "id": "telegram-notify-resolution-06",
      "name": "Notificar Resolución HITL",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1720, 320],
      "credentials": {
        "telegramApi": {
          "id": "9IhWvhoAHuzho5J5",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = String($json.message && $json.message.text ? $json.message.text : '').trim();\nconst is_sandbox = /^(?:\\/oh(?:\\s|$)|sandbox:)/i.test(text);\nreturn [{ json: { ...$json, is_sandbox, message_text: text } }];\n"
      },
      "id": "code-classify-13",
      "name": "Clasificar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 80]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_sandbox }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-sandbox-14",
      "name": "¿Misión sandbox?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1040, 80]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.missions = staticData.missions || {};\nconst id = String($json.message.message_id);\nstaticData.missions[id] = String($json.message.text || '');\nreturn [$json];\n"
      },
      "id": "code-save-mission-15",
      "name": "Guardar Texto Misión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1260, 20]
    },
    {
      "id": "telegram-send-buttons-04",
      "name": "Enviar Teclado HITL",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1480, 20],
      "credentials": {
        "telegramApi": {
          "id": "9IhWvhoAHuzho5J5",
          "name": "Telegram account"
        }
      },
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=⚡ Misión sandbox: \"{{ $json.message.text }}\"\n¿Autorizar ejecución en OpenHands?",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Aprobar",
                    "additionalFields": {
                      "callback_data": "=APPROVE_TASK:{{ $json.message.message_id }}"
                    }
                  },
                  {
                    "text": "❌ Rechazar",
                    "additionalFields": {
                      "callback_data": "=REJECT_TASK:{{ $json.message.message_id }}"
                    }
                  },
                  {
                    "text": "⏸️ Pausar",
                    "additionalFields": {
                      "callback_data": "=PAUSE_TASK:{{ $json.message.message_id }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      }
    },
